  <title>Baburav Voice Assistant</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #080808;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    .box {
      width: 90%;
      max-width: 450px;
      padding: 30px;
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
    }

    #status {
      color: #aaa;
      margin: 20px 0;
      min-height: 24px;
    }

    button {
      width: 180px;
      height: 60px;
      border: none;
      border-radius: 30px;
      font-size: 18px;
      cursor: pointer;
    }

    #result {
      margin-top: 25px;
      color: #ddd;
      word-break: break-word;
    }
  </style>
</head>

<body>

  <div class="box">
    <h1>Baburav</h1>

    <div id="status">Ready</div>

    <button id="micButton">🎙️ Speak</button>

    <div id="result"></div>
  </div>

